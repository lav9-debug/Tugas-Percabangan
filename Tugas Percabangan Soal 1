                Console.WriteLine("Hasil totalbayar dan totaldiskon dikali * = " + totalsemua);
                // Jika Totalbayar dan totaldiskon dibagi /
                int totalsemua1 = totalbayarBuku1 / totaldiskon1;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dibagi / = " + totalsemua1);
                diskon = "20%";
            }
            else if (totalbayarBuku2 == totalbayarBuku2)
            {
                // Jika Totalbayar dan totaldiskon dikali *
                int totalsemua = totalbayarBuku2 * totaldiskon2;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dikali * = " + totalsemua);
                // Jika Totalbayar dan totaldiskon dibagi /
                int totalsemua1 = totalbayarBuku2 / totaldiskon2;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dibagi / = " + totalsemua1);
                diskon = "20%";
            }
            else if (totalbayarBuku3 == totalbayarBuku3)
            {
                // Jika Totalbayar dan totaldiskon dikali *
                int totalsemua = totalbayarBuku3 * totaldiskon3;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dikali * = " + totalsemua);
                // Jika Totalbayar dan totaldiskon dibagi /
                int totalsemua1 = totalbayarBuku3 / totaldiskon3;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dibagi / = " + totalsemua1);
                diskon = "20%";
            }

            Console.WriteLine("Totalbayar = " + totalbayar + " dan diskon = " + diskon);
            Console.WriteLine("Totalbayar = " + totalbayarBuku1 + " dan diskon = " + diskon);
            Console.WriteLine("Totalbayar = " + totalbayarBuku2 + " dan diskon = " + diskon);
            Console.WriteLine("Totalbayar = " + totalbayarBuku3 + " dan diskon = " + diskon);
            
        }
