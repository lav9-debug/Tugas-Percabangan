            int Buku2 = 200;
            int Buku3 = 300;
            int Bulpen1 = 500;
            int Bulpen2 = 500;

            // totaldiskon hasil dari persenan jumlah 1600 contoh : 30% dari 1600 adalah 480
            int totalbayar = Buku1 + Buku2 + Buku3 + Bulpen1 + Bulpen2;
