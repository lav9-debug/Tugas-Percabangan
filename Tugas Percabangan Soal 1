            {
                
                // Jika Totalbayar dan totaldiskon dikali *
                int totalsemua = totalbayar * totaldiskon;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dikali * = " + totalsemua);
                // Jika Totalbayar dan totaldiskon dibagi /
                int totalsemua1 = totalbayar / totaldiskon;
                Console.WriteLine("Hasil totalbayar dan totaldiskon dibagi / = " + totalsemua1);
                diskon = "30%";
            }
            else if (totalbayarBuku1 == totalbayarBuku1)
            {
